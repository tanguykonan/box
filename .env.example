# Registry Configuration
# BOX_HUB_URL=https://boxhub.paxiz.org
# BOX_NETWORK_TIMEOUT=60

# Storage and Cache Directories (default: ~/.box)
# BOX_HOME=~/.box
# BOX_RUNTIMES_DIR=~/.box/runtimes
# BOX_VOLUMES_DIR=~/.box/volumes

# Packaging and Performance
# BOX_COMPRESSION_LEVEL=3
# BOX_BUILD_WORKERS=8

# Optional Runtime Mirrors
# BOX_PYTHON_MIRROR=https://www.python.org/ftp/python
# BOX_NODE_MIRROR=https://nodejs.org/dist
